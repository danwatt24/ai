{
  "name": "ai",
  "private": true,
  "workspaces": [
    "apps/chat-ui",
    "apps/server",
    "packages/*"
  ],
  "scripts": {
    "clean": "find . \\( -name node_modules -o -name dist \\) -type d -prune -exec rm -rf '{}' + && find . -name package-lock.json -delete",
    "create": "node tooling/create-app/index.js",
    "ui": "npm run dev --workspace=chat-ui",
    "server": "npm run dev --workspace=server",
    "chatbot": "concurrently --kill-others -n server,ui -c blue,green \"npm run server\" \"npm run ui\"",
    "llama": "llama-server --jinja -m ./models/qwen2.5-coder-32b-instruct-q4_k_m.gguf -c 16384 -ngl 99 -t 4 -tb 4 -fa on --port 8080",
    "qdrant": "docker run --rm -p 6333:6333 -p 6334:6334 qdrant/qdrant",
    "stack": "concurrently --kill-others -n llm,qdrant -c blue,green \"npm run llama\" \"npm run qdrant\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://https://github.com/danwatt24/ai.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/danwatt24/ai/issues"
  },
  "homepage": "https://github.com/danwatt24/ai#readme",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hono/node-server": "^2.0.4",
    "@huggingface/transformers": "^4.2.0",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "@repo/shared": "*",
    "better-sqlite3": "^13.0.2",
    "hono": "^4.12.23",
    "openai": "^6.43.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tsx": "^4.22.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
