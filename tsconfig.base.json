{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@repo/shared": ["./packages/shared/src/index.ts"],
      "@repo/shared/*": ["./packages/shared/src/*"]
    }
  }
}
